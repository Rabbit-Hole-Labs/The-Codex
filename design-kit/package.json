{
  "name": "@codex/design-kit",
  "version": "1.0.0",
  "description": "The Codex design system — React components and design tokens extracted from the Codex Chrome extension.",
  "type": "module",
  "module": "./dist/index.es.js",
  "main": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
